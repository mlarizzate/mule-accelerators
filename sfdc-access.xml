	var assignmentRuleId = remoteRequestConfig.assignmentRuleId default requestConfig.assignmentRuleId
	
	---
	(remoteRequestConfig default {}) 
	++	
	{
	    (apexClass: apexClass) if (isPropertyUsed(sfdcOperation, "apexClass")),
	    (apexClassMethod: apexClassMethod) if (isPropertyUsed(sfdcOperation, "apexClassMethod")),
	    (query: query) if (isPropertyUsed(sfdcOperation, "query")),
	    (objectType: objectType) if (isPropertyUsed(sfdcOperation, "objectType")),
	    (externalIdFieldName: externalIdFieldName) if (isPropertyUsed(sfdcOperation, "externalIdFieldName")),
	    (platformEventName: platformEventName) if (isPropertyUsed(sfdcOperation, "platformEventName")),
	    (operation: operation) if (isPropertyUsed(sfdcOperation, "operation")),
	    (lineEnding: lineEnding) if (isPropertyUsed(sfdcOperation, "lineEnding")),
	    (columnDelimiter: columnDelimiter) if (isPropertyUsed(sfdcOperation, "columnDelimiter")),
	    (assignmentRuleId: assignmentRuleId) if (isPropertyUsed(sfdcOperation, "assignmentRuleId"))
	}	
}
	

var updatedRequestConfig = updateRequestConfig(vars.sfdcOperation, vars.remoteCall.requestConfig, vars.requestConfig)

---
if (!vars.remoteCall.requestConfig?)
  (vars.remoteCall default {}) ++ {"requestConfig": updatedRequestConfig}
else
  vars.remoteCall update "requestConfig" with updatedRequestConfig]]></ee:set-variable>
